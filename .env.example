FLASK_ENV=production
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
PORT=5000
SECRET_KEY=change-this-to-a-long-random-secret
ALLOWED_ORIGINS=https://your-domain.com

# SQLite for local development and safe default boot:
DATABASE_URL=sqlite:///backend/database.db

# PostgreSQL for VPS / Render style deployment:
# DATABASE_URL=postgresql+psycopg://swiftcart:change_this_password@127.0.0.1:5432/swiftcart

# Railway:
# Do not paste placeholder text like USER:PASSWORD@HOST:5432/DBNAME.
# Instead, set DATABASE_URL to a Railway reference variable such as:
# DATABASE_URL=${{Postgres.DATABASE_URL}}

DB_POOL_SIZE=12
DB_MAX_OVERFLOW=24
DB_POOL_RECYCLE=1800

# Real OTP delivery on Railway or any SMTP-capable host:
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SwiftCart
SMTP_USE_TLS=1
# SMTP_USE_SSL=0

# Optional SMS OTP with Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Local development only. Never enable in production.
OTP_DEBUG_PREVIEW=0

# Secure seeded accounts. Set OWNER_PASSWORD before first production boot.
OWNER_EMAIL=owner@your-domain.com
OWNER_PASSWORD=
ENABLE_DEMO_MERCHANT=0
MERCHANT_DEMO_EMAIL=merchant@swiftcart.com
MERCHANT_DEMO_PASSWORD=
ROTATE_SEEDED_PASSWORDS=0
AUTH_TOKEN_MAX_AGE_SECONDS=604800

GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
